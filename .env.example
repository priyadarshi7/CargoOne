# Copy to api/.env
DATABASE_URL=postgresql+asyncpg://cargoone:cargoone@localhost:5432/cargoone
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage
# AI provider: mock | gemini | anthropic | openai | local
AI_PROVIDER=mock
AI_FALLBACKS=
GEMINI_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.85
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_S=20
