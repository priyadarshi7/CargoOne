# Copy to api/.env
DATABASE_URL=postgresql+asyncpg://cargoone:cargoone@localhost:5432/cargoone
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage
# AI provider: mock | gemini | anthropic | openai | local
AI_PROVIDER=mock
AI_FALLBACKS=
GEMINI_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.85
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_S=20
# dev | test | staging | production. Seed only runs in dev/test; non-dev REQUIRES a unique JWT_SECRET (32+ chars)
APP_ENV=dev

# Place search and the map picker (optional; without keys the free OpenStreetMap search is used)
# Create a Google Cloud project, enable billing and these APIs: Places API (New), Geocoding API, Maps JavaScript API. See docs/10-google-maps-setup.md
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
PLACES_PROVIDER=auto


# Online invoice payment through Razorpay Checkout (optional; both keys set = "Pay online" appears on a client's invoice)
# Dashboard > Account & Settings > API keys. Use the rzp_test_ pair until go-live. See docs/12-razorpay-setup.md
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional backup only: a secret YOU make up when adding the webhook (Settings > Webhooks) at https://<public host>/api/webhooks/razorpay, events payment.captured and order.paid
RAZORPAY_WEBHOOK_SECRET=

# Text messages (optional). mock = nothing is sent (the default; tests always use it). twilio = a driver's link is really texted.
# Twilio free trial: only numbers you have verified in the console can receive, and India needs a registered sender/template. See docs/14-sms-setup.md
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# a Twilio number in +E.164 form, OR a messaging service (set one of the two)
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# hard ceiling on real texts ever sent (counted in the audit log), so a trial balance is not used up by accident
SMS_MAX_TOTAL=60

# Tally Prime connection (optional). Tally must be open with a company loaded and its connection on (F1 Help > Settings > Connectivity). See docs/13-tally-setup.md
TALLY_URL=http://localhost:9000
TALLY_COMPANY=
TALLY_SALES_LEDGER=Freight Income

# --- Privacy (DPDP Act 2023) ---
# Shown on the public privacy notice at /privacy: the person people can write to
GRIEVANCE_OFFICER=
GRIEVANCE_EMAIL=
RETENTION_YEARS=8            # receiver details and POD photos are erased this long after a trip closes (0 = never)
REQUEST_RETENTION_DAYS=180   # declined transport requests
TRACKING_RETENTION_DAYS=30   # GPS fixes
PRIVACY_REPLY_DAYS=30        # the office's own target for answering a person's request
RETENTION_JOB=true           # the API runs the daily erase itself
# Photos of real PODs go to Groq/Gemini only when this is true (confirm a no-training paid tier first)
CLOUD_AI_CONFIRMED=false
